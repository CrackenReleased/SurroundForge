# Source-only allowlist. Everything private/generated is excluded by default.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/changelog.md
!/docs/
!/surround/

/surround/*
!/surround/Bridge.ps1
!/surround/Setup.ps1
!/surround/Start 5.1.cmd
!/surround/Stop 5.1.cmd
!/surround/tests/
!/surround/installer/
!/surround/source/

/surround/tests/output/
/surround/installer/*
!/surround/installer/*.ps1
!/surround/installer/*.txt

/surround/source/*
!/surround/source/LICENSE
!/surround/source/NOTICE.md
!/surround/source/engine/
!/surround/source/scripts/
!/surround/source/third_party/
/surround/source/scripts/*
!/surround/source/scripts/fetch-ffmpeg.ps1
/surround/source/third_party/*
!/surround/source/third_party/doctest/
!/surround/source/third_party/doctest/doctest.h
/surround/source/engine/build/

**/build/
**/output/
**/__pycache__/
*.pyc
*.exe
*.dll
*.lib
*.obj
*.pdb
*.sys
*.cat
*.msi
*.zip
*.evtx
*.log
*.reg
*.wav
*.ac3
*.spdif
.vs/
*.user
.DS_Store
